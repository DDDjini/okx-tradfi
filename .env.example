# ============================================================
#  环境变量模板 — 复制为 .env 后填入真实值
#  cp .env.example .env   (Windows: copy .env.example .env)
# ============================================================

# --- 飞书自定义机器人 ---
# 创建方式：飞书群 → 设置 → 群机器人 → 添加自定义机器人
# 安全设置建议勾选「自定义关键词」填：信号
# 若选了「签名校验」则把密钥填入 FEISHU_SECRET
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/你的机器人地址
FEISHU_SECRET=

# --- 代理（国内网络访问 OKX 必需）---
# Clash 默认 7890；v2ray 默认 10809
# socks5 写法：socks5://127.0.0.1:1080
# 海外服务器可直连则留空
PROXY_URL=http://127.0.0.1:7890
